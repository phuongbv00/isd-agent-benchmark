# ISD-Agent-Bench optional environment defaults
# You do not need .env if you pass complete --agent-model-* and --judge-model-* flags.
# Copy this file to .env only when you want persistent defaults or secret env vars.

# ---------------------------------------------------------------------------
# Agent model: used by benchmark agents to generate instructional-design output
# ---------------------------------------------------------------------------
# Provider is a backend preset:
#   openrouter, openai, upstage, anthropic
#   local-ollama, local-lmstudio, local-vllm
#
# API spec is the backend API contract:
#   openai_compatible: OpenAI, OpenRouter, Upstage, Ollama, LM Studio, vLLM
#   anthropic: Anthropic native API

# Example A: OpenRouter
AGENT_MODEL_PROVIDER=openrouter
AGENT_MODEL_API_SPEC=openai_compatible
AGENT_MODEL_NAME=anthropic/claude-opus-4.5
AGENT_MODEL_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL_API_KEY_ENV=OPENROUTER_API_KEY
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Example B: Upstage Solar agent model with round-robin credentials
# AGENT_MODEL_PROVIDER=upstage
# AGENT_MODEL_API_SPEC=openai_compatible
# AGENT_MODEL_NAME=solar-pro3
# AGENT_MODEL_BASE_URL=https://api.upstage.ai/v1/solar
# AGENT_MODEL_API_KEY_ENVS=UPSTAGE_API_KEY,UPSTAGE_API_KEY2,UPSTAGE_API_KEY3
# AGENT_MODEL_CREDENTIAL_STRATEGY=round_robin
# UPSTAGE_API_KEY=your-upstage-api-key-here
# UPSTAGE_API_KEY2=
# UPSTAGE_API_KEY3=

# Example C: OpenAI agent model
# AGENT_MODEL_PROVIDER=openai
# AGENT_MODEL_API_SPEC=openai_compatible
# AGENT_MODEL_NAME=gpt-4o-mini
# AGENT_MODEL_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=your-openai-api-key-here

# Example D: Anthropic native agent model
# AGENT_MODEL_PROVIDER=anthropic
# AGENT_MODEL_API_SPEC=anthropic
# AGENT_MODEL_NAME=claude-3-5-sonnet-latest
# AGENT_MODEL_API_KEY_ENV=ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Example E: Local Ollama OpenAI-compatible endpoint
# AGENT_MODEL_PROVIDER=local-ollama
# AGENT_MODEL_API_SPEC=openai_compatible
# AGENT_MODEL_NAME=qwen2.5:14b
# AGENT_MODEL_BASE_URL=http://localhost:11434/v1
# AGENT_MODEL_API_KEY=not-needed

# Example F: Local LM Studio OpenAI-compatible endpoint
# AGENT_MODEL_PROVIDER=local-lmstudio
# AGENT_MODEL_API_SPEC=openai_compatible
# AGENT_MODEL_NAME=local-model
# AGENT_MODEL_BASE_URL=http://localhost:1234/v1
# AGENT_MODEL_API_KEY=not-needed

# ---------------------------------------------------------------------------
# Agent generation settings
# ---------------------------------------------------------------------------
# AGENT_MODEL_TEMPERATURE=0.7
# REASONING_BUDGET=0

# Per-call output budget requested by an agent, when it sets none of its own.
# AGENT_MODEL_MAX_TOKENS=4096

# Central clamp applied to EVERY agent's output budget in shared/llm/factory.py
# (max_tokens = min(agent's own, this)). Unset = each agent's own budget stands.
# This is the fairness knob for the self-hosted ladder; AGENT_MODEL_MAX_TOKENS
# above is only a default for agents that ask for nothing.
# AGENT_MODEL_MAX_OUTPUT_TOKENS=8192

# ---------------------------------------------------------------------------
# Self-hosted serving protection (vLLM/RunPod ladder; uniform across agents)
# ---------------------------------------------------------------------------
# Client-side streaming with stream_usage. Required behind proxies that time out
# a long non-streaming read (RunPod/Cloudflare 524).
# AGENT_MODEL_STREAMING=1

# The window the endpoint was launched with, in tokens. Read by the
# alignmentgraph-isd adapter to size its transcript budget
# (window - AGENT_MODEL_MAX_OUTPUT_TOKENS); unset keeps a fixed 24k-char default.
# AGENT_MODEL_CONTEXT_WINDOW=16384

# Ladder slots (QWEN08B_/QWEN2B_/QWEN4B_/QWEN9B_AGENT_MODEL_*) live in a
# marker-managed block written by scripts/3_sync_runpod_pods_env.py — do not
# hand-edit it. Only scripts/4_run_benchmark.sh and 02_run_ladder.sh read slots.

# ---------------------------------------------------------------------------
# Judge models: used by the evaluator to score agent outputs
# ---------------------------------------------------------------------------
# The evaluator is intentionally separate from the agent model to reduce
# self-preference bias.
#
# Single-provider judge example:
JUDGE_MODEL_PROVIDER=openrouter
JUDGE_MODEL_NAMES=openai/gpt-4o-mini,google/gemini-2.5-flash-lite
JUDGE_MODEL_BASE_URL=https://openrouter.ai/api/v1
JUDGE_MODEL_API_KEY_ENV=OPENROUTER_API_KEY

# Multi-provider judge example:
# JUDGE_MODEL_NAMES=openai/gpt-4o-mini,solar-pro3
# JUDGE_MODEL_PROVIDERS=openrouter,upstage
# JUDGE_MODEL_BASE_URLS=https://openrouter.ai/api/v1,https://api.upstage.ai/v1/solar
# JUDGE_MODEL_API_KEY_ENVS=OPENROUTER_API_KEY|OPENROUTER_API_KEY2,UPSTAGE_API_KEY
# JUDGE_MODEL_CREDENTIAL_STRATEGIES=round_robin,first

# Local judge example:
# JUDGE_MODEL_PROVIDER=local-lmstudio
# JUDGE_MODEL_NAMES=local-judge-model
# JUDGE_MODEL_BASE_URL=http://localhost:1234/v1
# JUDGE_MODEL_API_KEY=not-needed

# ---------------------------------------------------------------------------
# Endpoint overrides
# ---------------------------------------------------------------------------
# Used when scripts pass explicit --agent-model-base-url / --judge-model-base-url
# flags. Override only for a proxy or custom endpoint.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# UPSTAGE_BASE_URL=https://api.upstage.ai/v1/solar
